//kage:unit pixels
package main

var CamAngle float
var Focal float
var DrawW float
var DrawH float
var SampleW float
var SampleH float
var SkyTexW float
var SkyTexH float
var SharpUpscale float

func wrap(v, n float) float {
	return v - floor(v/n)*n
}

func sampleSkyPoint(u, v float) vec4 {
	src := vec2(wrap(u+0.5, SkyTexW), wrap(v+0.5, SkyTexH)) + imageSrc0Origin()
	return imageSrc0At(src)
}

func prefilterSky(center, left, right, up, down vec4) vec4 {
	// Preserve the original prefilter's sample positions and arithmetic order.
	c := center * 0.7
	c += left * 0.075
	c += right * 0.075
	c += up * 0.075
	c += down * 0.075
	return c
}

func catmullRomWeights(t float) vec4 {
	t2 := t * t
	t3 := t2 * t
	return vec4(
		-0.5*t+t2-0.5*t3,
		1.0-2.5*t2+1.5*t3,
		0.5*t+2.0*t2-1.5*t3,
		-0.5*t2+0.5*t3,
	)
}

func minRGB2(a, b vec3) vec3 {
	return vec3(min(a.x, b.x), min(a.y, b.y), min(a.z, b.z))
}

func maxRGB2(a, b vec3) vec3 {
	return vec3(max(a.x, b.x), max(a.y, b.y), max(a.z, b.z))
}

func sampleSkySharp(u, v float) vec4 {
	baseU := floor(u)
	baseV := floor(v)
	wu := catmullRomWeights(u - baseU)
	wv := catmullRomWeights(v - baseV)
	// Adjacent prefilter centers share their half-texel edge samples.
	// Cache 20 horizontal and 20 vertical edges plus 16 centers: 56 reads.
	h00 := sampleSkyPoint(baseU-1.5, baseV-1.0)
	h10 := sampleSkyPoint(baseU-0.5, baseV-1.0)
	h20 := sampleSkyPoint(baseU+0.5, baseV-1.0)
	h30 := sampleSkyPoint(baseU+1.5, baseV-1.0)
	h40 := sampleSkyPoint(baseU+2.5, baseV-1.0)
	h01 := sampleSkyPoint(baseU-1.5, baseV)
	h11 := sampleSkyPoint(baseU-0.5, baseV)
	h21 := sampleSkyPoint(baseU+0.5, baseV)
	h31 := sampleSkyPoint(baseU+1.5, baseV)
	h41 := sampleSkyPoint(baseU+2.5, baseV)
	h02 := sampleSkyPoint(baseU-1.5, baseV+1.0)
	h12 := sampleSkyPoint(baseU-0.5, baseV+1.0)
	h22 := sampleSkyPoint(baseU+0.5, baseV+1.0)
	h32 := sampleSkyPoint(baseU+1.5, baseV+1.0)
	h42 := sampleSkyPoint(baseU+2.5, baseV+1.0)
	h03 := sampleSkyPoint(baseU-1.5, baseV+2.0)
	h13 := sampleSkyPoint(baseU-0.5, baseV+2.0)
	h23 := sampleSkyPoint(baseU+0.5, baseV+2.0)
	h33 := sampleSkyPoint(baseU+1.5, baseV+2.0)
	h43 := sampleSkyPoint(baseU+2.5, baseV+2.0)
	v00 := sampleSkyPoint(baseU-1.0, baseV-1.5)
	v10 := sampleSkyPoint(baseU, baseV-1.5)
	v20 := sampleSkyPoint(baseU+1.0, baseV-1.5)
	v30 := sampleSkyPoint(baseU+2.0, baseV-1.5)
	v01 := sampleSkyPoint(baseU-1.0, baseV-0.5)
	v11 := sampleSkyPoint(baseU, baseV-0.5)
	v21 := sampleSkyPoint(baseU+1.0, baseV-0.5)
	v31 := sampleSkyPoint(baseU+2.0, baseV-0.5)
	v02 := sampleSkyPoint(baseU-1.0, baseV+0.5)
	v12 := sampleSkyPoint(baseU, baseV+0.5)
	v22 := sampleSkyPoint(baseU+1.0, baseV+0.5)
	v32 := sampleSkyPoint(baseU+2.0, baseV+0.5)
	v03 := sampleSkyPoint(baseU-1.0, baseV+1.5)
	v13 := sampleSkyPoint(baseU, baseV+1.5)
	v23 := sampleSkyPoint(baseU+1.0, baseV+1.5)
	v33 := sampleSkyPoint(baseU+2.0, baseV+1.5)
	v04 := sampleSkyPoint(baseU-1.0, baseV+2.5)
	v14 := sampleSkyPoint(baseU, baseV+2.5)
	v24 := sampleSkyPoint(baseU+1.0, baseV+2.5)
	v34 := sampleSkyPoint(baseU+2.0, baseV+2.5)
	p00 := prefilterSky(sampleSkyPoint(baseU-1.0, baseV-1.0), h00, h10, v00, v01)
	p10 := prefilterSky(sampleSkyPoint(baseU, baseV-1.0), h10, h20, v10, v11)
	p20 := prefilterSky(sampleSkyPoint(baseU+1.0, baseV-1.0), h20, h30, v20, v21)
	p30 := prefilterSky(sampleSkyPoint(baseU+2.0, baseV-1.0), h30, h40, v30, v31)
	p01 := prefilterSky(sampleSkyPoint(baseU-1.0, baseV), h01, h11, v01, v02)
	p11 := prefilterSky(sampleSkyPoint(baseU, baseV), h11, h21, v11, v12)
	p21 := prefilterSky(sampleSkyPoint(baseU+1.0, baseV), h21, h31, v21, v22)
	p31 := prefilterSky(sampleSkyPoint(baseU+2.0, baseV), h31, h41, v31, v32)
	p02 := prefilterSky(sampleSkyPoint(baseU-1.0, baseV+1.0), h02, h12, v02, v03)
	p12 := prefilterSky(sampleSkyPoint(baseU, baseV+1.0), h12, h22, v12, v13)
	p22 := prefilterSky(sampleSkyPoint(baseU+1.0, baseV+1.0), h22, h32, v22, v23)
	p32 := prefilterSky(sampleSkyPoint(baseU+2.0, baseV+1.0), h32, h42, v32, v33)
	p03 := prefilterSky(sampleSkyPoint(baseU-1.0, baseV+2.0), h03, h13, v03, v04)
	p13 := prefilterSky(sampleSkyPoint(baseU, baseV+2.0), h13, h23, v13, v14)
	p23 := prefilterSky(sampleSkyPoint(baseU+1.0, baseV+2.0), h23, h33, v23, v24)
	p33 := prefilterSky(sampleSkyPoint(baseU+2.0, baseV+2.0), h33, h43, v33, v34)
	row0 := p00*wu.x + p10*wu.y + p20*wu.z + p30*wu.w
	row1 := p01*wu.x + p11*wu.y + p21*wu.z + p31*wu.w
	row2 := p02*wu.x + p12*wu.y + p22*wu.z + p32*wu.w
	row3 := p03*wu.x + p13*wu.y + p23*wu.z + p33*wu.w
	c := row0*wv.x + row1*wv.y + row2*wv.z + row3*wv.w
	localMin := p00.rgb
	localMax := p00.rgb
	localMin = minRGB2(localMin, p10.rgb)
	localMax = maxRGB2(localMax, p10.rgb)
	localMin = minRGB2(localMin, p20.rgb)
	localMax = maxRGB2(localMax, p20.rgb)
	localMin = minRGB2(localMin, p30.rgb)
	localMax = maxRGB2(localMax, p30.rgb)
	localMin = minRGB2(localMin, p01.rgb)
	localMax = maxRGB2(localMax, p01.rgb)
	localMin = minRGB2(localMin, p11.rgb)
	localMax = maxRGB2(localMax, p11.rgb)
	localMin = minRGB2(localMin, p21.rgb)
	localMax = maxRGB2(localMax, p21.rgb)
	localMin = minRGB2(localMin, p31.rgb)
	localMax = maxRGB2(localMax, p31.rgb)
	localMin = minRGB2(localMin, p02.rgb)
	localMax = maxRGB2(localMax, p02.rgb)
	localMin = minRGB2(localMin, p12.rgb)
	localMax = maxRGB2(localMax, p12.rgb)
	localMin = minRGB2(localMin, p22.rgb)
	localMax = maxRGB2(localMax, p22.rgb)
	localMin = minRGB2(localMin, p32.rgb)
	localMax = maxRGB2(localMax, p32.rgb)
	localMin = minRGB2(localMin, p03.rgb)
	localMax = maxRGB2(localMax, p03.rgb)
	localMin = minRGB2(localMin, p13.rgb)
	localMax = maxRGB2(localMax, p13.rgb)
	localMin = minRGB2(localMin, p23.rgb)
	localMax = maxRGB2(localMax, p23.rgb)
	localMin = minRGB2(localMin, p33.rgb)
	localMax = maxRGB2(localMax, p33.rgb)
	center := p11.rgb
	sharpened := c.rgb + (c.rgb-center)*0.18
	return vec4(clamp(sharpened, localMin, localMax), 1.0)
}

func Fragment(dstPos vec4, srcPos vec2, color vec4, custom vec4) vec4 {
	if Focal <= 0.0 || DrawW <= 0.0 || DrawH <= 0.0 || SampleW <= 0.0 || SampleH <= 0.0 || SkyTexW <= 0.0 || SkyTexH <= 0.0 {
		return vec4(0.0, 0.0, 0.0, 1.0)
	}
	pi := 3.141592653589793
	// Carry draw-space coordinates explicitly through custom varyings rather than
	// depending on source texture interpolation semantics.
	x := custom.x + 0.5
	y := custom.y + 0.5
	if SharpUpscale < 0.5 {
		// Fragment varyings already lie at pixel centers.
		x = custom.x
		y = custom.y
	}
	// Quantize through the same internal sample grid used by the CPU sky lookup,
	// so detail-level and presentation-size changes stay bit-consistent.
	sampleXi := floor(x * (SampleW / DrawW))
	if sampleXi < 0.0 {
		sampleXi = 0.0
	} else if sampleXi > SampleW-1.0 {
		sampleXi = SampleW - 1.0
	}
	sampleYi := floor(y * (SampleH / DrawH))
	if sampleYi < 0.0 {
		sampleYi = 0.0
	} else if sampleYi > SampleH-1.0 {
		sampleYi = SampleH - 1.0
	}
	sx := sampleXi + 0.5
	sy := sampleYi
	cx := SampleW * 0.5
	cy := SampleH * 0.5
	ang := CamAngle + atan((cx-sx)/Focal)
	uScale := (SkyTexW * 4.0) / (2.0 * pi)
	u := wrap(ang*uScale, SkyTexW)
	iscale := 320.0 / SampleW
	v := wrap(100.0+((sy-cy)*iscale), SkyTexH)
	_ = dstPos
	_ = srcPos
	c := sampleSkyPoint(floor(u), floor(v))
	if SharpUpscale >= 0.5 {
		c = sampleSkySharp(u, v)
	}
	return vec4(c.rgb, 1.0)
}
